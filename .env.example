# Copy to .env and fill in. See README.md for how to generate secrets.

# ============================================================ Wanderer (infra)
POSTGRES_PASSWORD=            # openssl rand -hex 16
WANDERER_VERSION=latest
WANDERER_BIND=8000

# ========================================================= Alliance Auth (app)
AA_DOCKER_TAG=registry.gitlab.com/allianceauth/allianceauth/auth:v5.2.0
AA_BIND=8001
AA_SITE_URL=http://localhost:8001
AA_SITENAME=Alliance Auth Testbed
AA_DEBUG=True

AA_SECRET_KEY=               # openssl rand -base64 48

AA_DB_HOST=aa_mysql
AA_DB_PORT=3306
AA_DB_NAME=alliance_auth
AA_DB_USER=aauth
AA_DB_PASSWORD=              # openssl rand -hex 16
AA_DB_ROOT_PASSWORD=         # openssl rand -hex 16
AA_DB_CHARSET=utf8mb4

AA_REDIS=aa_redis:6379

# EVE SSO app for AA (separate from Wanderer). Callback: <AA_SITE_URL>/sso/callback
ESI_SSO_CLIENT_ID=changeme
ESI_SSO_CLIENT_SECRET=changeme
ESI_USER_CONTACT_EMAIL=you@example.com

AA_EMAIL_HOST=
AA_EMAIL_PORT=587
AA_EMAIL_HOST_USER=
AA_EMAIL_HOST_PASSWORD=
AA_EMAIL_USE_TLS=True
AA_DEFAULT_FROM_EMAIL=
