# Copy to wanderer-conf.env and fill in. Application config, passed into the
# wanderer container. See README.md for how to generate secrets.

# Base URL used for link generation and the EVE SSO callback. Must match the
# callback URL registered at https://developers.eveonline.com exactly.
WEB_APP_URL=http://localhost:8000

# CLOAK_KEY encrypts character tokens at rest - changing it orphans existing data.
SECRET_KEY_BASE=            # openssl rand -base64 48
CLOAK_KEY=                  # openssl rand -base64 32

# EVE SSO application credentials. Create an app at https://developers.eveonline.com with
# callback URL http://localhost:8000/auth/eve/callback and these scopes:
#   esi-location.read_location.v1
#   esi-location.read_ship_type.v1
#   esi-location.read_online.v1
#   esi-search.search_structures.v1
#   esi-ui.write_waypoint.v1
EVE_CLIENT_ID=changeme
EVE_CLIENT_SECRET=changeme

# Basic-auth for /admin. Without a password the admin panel is wide open.
WANDERER_ADMIN_USERNAME=admin
WANDERER_ADMIN_PASSWORD=            # pick anything for local use

# Registration and feature toggles.
# WANDERER_INVITES=true                  # invite-only signup
WANDERER_RESTRICT_MAPS_CREATION=true   # only admins may create maps
WANDERER_PUBLIC_API_DISABLED=false
WANDERER_CHARACTER_API_DISABLED=false
